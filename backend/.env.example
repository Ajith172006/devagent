# ── Server ────────────────────────────────────────────────────────────────────
PORT=8080

# ── PostgreSQL ────────────────────────────────────────────────────────────────
DB_URL=jdbc:postgresql://localhost:5432/devagent
DB_USERNAME=postgres
DB_PASSWORD=postgres

# ── Hibernate DDL ─────────────────────────────────────────────────────────────
# update  = auto-migrate on startup (dev)
# validate = only validate schema (prod)
# none     = do nothing
DDL_AUTO=update

# ── Firebase ──────────────────────────────────────────────────────────────────
# Project ID for token verification
FIREBASE_PROJECT_ID=devagent-c0aaf
# Set GOOGLE_APPLICATION_CREDENTIALS env var to path of your service account JSON
# OR run on GCP where Application Default Credentials work automatically
# For local dev with bypass: set BYPASS_FIREBASE_AUTH=true instead

# ── Dev auth bypass (skip Firebase token verification) ────────────────────────
# Set to true so you can use x-user-id header directly without a real token
BYPASS_FIREBASE_AUTH=true

# ── Gemini AI ─────────────────────────────────────────────────────────────────
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# ── GitHub ────────────────────────────────────────────────────────────────────
# Optional PAT — raises rate limit from 60 to 5000 req/hour
GITHUB_TOKEN=

# ── Admin ─────────────────────────────────────────────────────────────────────
ADMIN_SECRET=devagent_admin_2025

# ── CORS ──────────────────────────────────────────────────────────────────────
FRONTEND_ORIGINS=http://localhost:5173,http://localhost:5174
