# Backend API Base URL
# Local dev: http://localhost:8080/api (or leave empty to use Vite proxy)
# Production (Render): https://devagent-5xf2.onrender.com/api
VITE_API_URL=https://devagent-5xf2.onrender.com/api

# Firebase config — get these from https://console.firebase.google.com
# Project Settings → Your apps → Web app → firebaseConfig
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
